{
  "name": "latex2js-workspace",
  "version": "0.0.1",
  "publishConfig": {
    "access": "restricted"
  },
  "private": true,
  "scripts": {
    "build": "lerna run build",
    "dev": "vite",
    "dev:watch": "concurrently -n \"BUILD,VITE\" -c \"cyan,magenta\" \"node watch-build.js\" \"vite\"",
    "build:watch": "node watch-build.js",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@unocss/preset-uno": "^66.6.0",
    "@unocss/vite": "^66.6.0",
    "chokidar": "^3.6.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^8.2.2",
    "copyfiles": "^2.4.1",
    "jest": "^29.7.0",
    "lerna": "^8.2.3",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.0",
    "unocss": "^66.6.0",
    "vite": "^5.4.21"
  },
  "workspaces": [
    "packages/*",
    "website/*",
    "examples/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Mathapedia/LaTeX2JS"
  }
}